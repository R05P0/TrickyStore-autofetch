id=trickystore_autofetch
name=TrickyStore Autofetch
version=v1.4.0
versionCode=5
author=R05P0
description=Keeps Tricky Store supplied with a working attestation keybox. On a schedule it checks Google's revocation list AND the leaf certificate's expiry, and if the current keybox is revoked or expired it fetches a fresh one (ddex/Yurikey/custom, with failover), validates it, installs it to keybox.xml and notifies you. One-tap Apply re-attests and reboots. Never touches Tricky Store's own module files.
updateJson=https://raw.githubusercontent.com/R05P0/TrickyStore-autofetch/main/update.json
